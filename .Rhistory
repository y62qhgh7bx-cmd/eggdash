###分品系、世代、批次
#計算批次生日(眾數)
get_mode <- function(x) {
# 移除 NA 後再統計
x_no_na <- x[!is.na(x)]
# 計算每個獨特值出現的次數
counts <- table(x_no_na)
# 找到最常出現的值
mode_value <- names(counts)[which.max(counts)]
# 若 x 原本是 Date，names(counts) 會是字串，需轉回 Date
# 如果 x 是 Date 類型，這裡再轉回 as.Date
if (inherits(x_no_na, "Date")) {
mode_value <- as.Date(mode_value)
}
return(mode_value)
}
summarize_eggs_by_date_line_gen <- function(egg_data, pedigree) {
# egg_data: 格式(date, cage, egg=0/1)
# pedigree: 格式(cage, line, gen, hatch, sex, birthday, ...)
# 合併品系、世代、批次等欄位
# 以及要計算日齡所需的 birthday、判斷雌鴨的 sex
#「取眾數」的函數
#=== (A) 不考慮 ddate，計算 daily_eggs / female_count ===#
egg_1 <- egg_data %>%
left_join(
pedigree %>% select(cage, line, gen, hatch, sex, birthday, start_date, end_date),
by = "cage"
) %>%
# 只保留母鴨
filter(sex == 2) %>%
group_by(date, line, gen, hatch) %>%
summarize(
daily_eggs    = sum(egg, na.rm = TRUE),
female_count  = n(),
birthday  = get_mode(birthday),
start_date = get_mode(start_date),
end_date = get_mode(end_date),
.groups = "drop"
)
# 只保留「日期落在 [start_date, end_date]」的紀錄
#    (若 start_date/end_date 有 NA，您可視需求決定如何處理)
egg_1 <- egg_1 %>%
filter(date >= start_date & date <= end_date)
#=== (B) 考慮 ddate，只計存活鴨 => female_real ===#
egg_2 <- egg_data %>%
left_join(
pedigree %>% select(cage, line, gen, hatch, sex, birthday, ddate),
by = "cage"
) %>%
filter(
sex == 2,
# 若 ddate 不為 NA，則只保留 date <= ddate
is.na(ddate) | date <= ddate
) %>%
group_by(date, line, gen, hatch) %>%
summarize(
female_real = n_distinct(cage),
.groups = "drop"
)
#=== (C) 將兩份 daily 資料合併 ===#
daily_line_gen <- egg_1 %>%
left_join(egg_2, by = c("date", "line", "gen", "hatch"))
# 計算隻日產蛋率 = 每日蛋數 / 當日實際雌鴨數 #隻日hen-day production #隻舍hen-housed production
daily_line_gen <- daily_line_gen %>%
mutate(
hen_housed_production = if_else(female_count > 0,
daily_eggs / female_count,
NA_real_),
hen_day_production = if_else(female_count > 0,
daily_eggs / female_real,
NA_real_),
day_age = as.numeric(date - birthday)
)
return(daily_line_gen)
}
#會跑較久
daily_line_summary<-summarize_eggs_by_date_line_gen(egg_data, pedigree)
View(daily_line_summary)
write.csv(daily_line_summary,file="daily_line_summary.csv",row.names = FALSE)

# 產生 cage (或 cage) 編號
mutate(
cage = paste0(area, line * 100 + idx)
) %>%
select(date, cage, egg)
View(egg_data)
View(combined_egg_data)
View(egg_data)
summarize_eggs_by_cage <- function(egg_data, pedigree) {
# egg_data: 原始產蛋紀錄，包含 (date, cage, egg=0/1, ...)
# pedigree: 系譜，包含 (cage, line, gen, start_date, end_date, birthday, alive, ddate, ...)
#-----------------------------
# 第1步：合併系譜中的必要欄位
#-----------------------------
egg_with_info <- egg_data %>%
left_join(
pedigree %>% select(cage, line, gen, start_date, end_date, birthday, alive, ddate),
by = "cage"
)
#-----------------------------
# 第2步：先用「世代起止日」篩選出有效紀錄
#        只保留 date ∈ [start_date, end_date] 的紀錄
#-----------------------------
# 注意：若同一籠有多筆 (line, gen, start_date, end_date)，
#       就會在前面 left_join 後得到對應的多行，但只要 date 落在區間以內才算該世代有效。
egg_with_info <- egg_with_info %>%
filter(date >= start_date & date <= end_date)
#-----------------------------
# 第3步：若鴨已死亡 (ddate不為NA)，則觀測到 ddate 為止
#        否則觀測到全局的最後紀錄日 (或 end_date 也可一起取最小值)
#-----------------------------
last_record_date <- max(egg_with_info$date, na.rm = TRUE)
egg_with_info <- egg_with_info %>%
mutate(
# 真正的有效結束日 = min(世代end_date, ddate, 全局最後紀錄日)
# 若 ddate = NA, 用 end_date; 若 end_date = NA, 用 last_record_date
effective_last_day = pmin(
end_date,
if_else(!is.na(ddate), ddate, last_record_date),
na.rm = TRUE  # 忽略 NA
)
) %>%
# date 超過有效結束日的排除
filter(date <= effective_last_day)
#-----------------------------
# 第4步：計算鴨齡 day_age
#-----------------------------
egg_with_info <- egg_with_info %>%
mutate(birthday=as.Date(birthday),
day_age = as.numeric(date - birthday))
#-----------------------------
# 第5步：以 (cage, line, gen) 分組，做各項統計
#        或僅以 cage 分組也可，視分析需求
#-----------------------------
cage_summary <- egg_with_info %>%
group_by(cage, line, gen) %>%
summarize(
#firstegg = min(date[egg == 1], na.rm = TRUE), 1140421rev
#lastegg  = max(date[egg == 1], na.rm = TRUE),
firstegg = if (any(egg == 1)) min(date[egg == 1]) else as.Date(NA),
lastegg  = if (any(egg == 1)) max(date[egg == 1]) else as.Date(NA),
total_eggs = sum(egg, na.rm = TRUE),
# 40週(280天)內的蛋數
EN40 = sum(if_else(day_age <= 280, egg, 0L), na.rm=TRUE),
# 52週(364天)內的蛋數
EN52 = sum(if_else(day_age <= 364, egg, 0L), na.rm=TRUE),
# 最後紀錄日(含世代end_date、死亡日等綜合考量後)
last_record_date = max(effective_last_day, na.rm=TRUE),
# 計算該群體最後觀測到的鴨齡(可能就是死亡齡或end_date時的鴨齡)
last_age = max(day_age, na.rm=TRUE),
# 14天內的產蛋數(以 last_record_date 為基準)
EN14 = sum(if_else(date >= (max(effective_last_day, na.rm=TRUE) - 13), egg, 0L), na.rm=TRUE),
.groups = "drop"
)
#-----------------------------
# 第6步：再與 pedigree 其餘欄位做一次合併，並做 EN40/EN52 的 NA 判斷
#        合併鍵改用 (cage, line, gen)，以分辨不同世代
#-----------------------------
result <- pedigree %>%
left_join(cage_summary, by = c("cage", "line", "gen")) %>%
mutate(
# 初產日齡
age_first_egg = as.numeric(firstegg - birthday),
# 若最後觀測的鴨齡 < 280 => EN40=NA
EN40 = if_else(last_age < 280, NA_real_, as.double(EN40)),
# 若最後觀測的鴨齡 < 364 => EN52=NA
EN52 = if_else(last_age < 364, NA_real_, as.double(EN52))
)
return(result)
}
ind_summary<-summarize_eggs_by_cage(egg_data, pedigree)
View(egg_data)
View(ind_summary)
# 從 pedigree 抓每個品系最新世代----
groups <- pedigree %>%
group_by(line) %>%
slice_max(gen, n = 1, with_ties = FALSE) %>%
ungroup() %>%
arrange(line)
# 依序篩選並匯出對應 ind_summary 的檔案
for (i in 1:nrow(groups)) {
line_i <- groups$line[i]
gen_i <- groups$gen[i]
exportind <- ind_summary %>%
filter(line == line_i, gen == gen_i) %>%
relocate(
lastegg, last_record_date, age_first_egg, EN40, EN52, total_eggs, EN14, last_age,
.after = firstegg
) %>%
arrange(cage)
file_name <- paste0(line_i, "g", gen_i,"_",today_str, ".csv")
write.csv(exportind,
file = file.path(output_path, file_name),
row.names = FALSE,
na = ".")
}

#只算每日總產蛋數(不需個體資料)
summarize_eggs_by_date_and_line <- function(egg_data, pedigree) {
# egg_data: 格式(date, cage, egg=0/1)
# # pedigree: 格式(cage, line, hatch, start_date, end_date, ...)
#
# # 1) 合併品系(或批次)欄位 + 有效期( start_date, end_date )
# egg_with_line <- egg_data %>%
#   left_join(
#     pedigree %>% select(cage, line, hatch, start_date, end_date),
#     by = "cage"
#   )
#
# # 2) 只保留「日期落在 [start_date, end_date]」的紀錄
# #    (若 start_date/end_date 有 NA，您可視需求決定如何處理)
# egg_with_line <- egg_with_line %>%
#   filter(date >= start_date & date <= end_date)
#
# # 3) 按 (date, line, hatch) 分組，計算該日該品系(或批次)的產蛋數
daily_summary <- egg_data %>%
group_by(date) %>%
summarize(
total_eggs = sum(egg, na.rm = TRUE),
.groups = "drop"
)
return(daily_summary)
}
